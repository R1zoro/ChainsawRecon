# ── LLM Providers ──────────────────────────────────────────────────────────
# Ollama (local)
OLLAMA_API_KEY=ollama
# Increase timeout if Ollama times out at 4 minutes (default: 600)
OLLAMA_TIMEOUT=600

# Ollama context window (must be set before starting ollama serve)
# Start with 16384 only if the selected model remains stable on your hardware.
OLLAMA_NUM_CTX=16384

# Groq (cloud, fast)
GROQ_API_KEY=gsk_your_key_here

# Google AI Studio (Gemini) — get a free key at https://aistudio.google.com/apikey
# Use with: --provider gemini
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter (single key for many models) — get a key at https://openrouter.ai/keys
# Use with: --provider openrouter
OPENROUTER_API_KEY=sk-or-your_key_here

# NVIDIA hosted NIM/API Catalog endpoints (OpenAI-compatible)
# Obtain a key from build.nvidia.com. Keep this local and never commit it.
NVIDIA_API_KEY=nvapi-your-key-here
# Client-side rolling-window pacing; the server remains authoritative.

# ── Research / Search ──────────────────────────────────────────────────────
# Tavily search (for the `research` tool action, source=tavily)
# Get a free key at https://tavily.com
TAVILY_API_KEY=tvly-your-key-here
