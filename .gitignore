# Python tooling and generated bytecode
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
pytest-cache-files-*/
.uv-cache/
.venv/

# Local engagements are sensitive. Track only the reusable template scaffolding.
/engagements/*/
!/engagements/_template/
!/engagements/_template/README.md
!/engagements/_template/program/
!/engagements/_template/program/**
!/engagements/_template/manual/
!/engagements/_template/manual/**
!/engagements/_template/agent/
!/engagements/_template/agent/README.md
/engagements/_template/agent/runs/

# Generated runtime state outside an ignored engagement.
/runs/
/artifacts/
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.jsonl

# Credentials and machine-local configuration. Examples remain versioned.
.env
.env.*
!.env.example
**/secrets.env
**/secrets.env.*
!**/secrets.env.example
*.pem
*.key
*.p12
*.pfx

# Local tool output and editor state
.tmp/
pytest-temp/
sandbox/test-recon-db/
sandbox/test-local-runner/
.aider*
.DS_Store
Thumbs.db

# Generated test-run artifacts; keep normal test source files versioned.
/tests/LDrun_test/
