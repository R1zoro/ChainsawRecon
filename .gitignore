# Python tooling and generated bytecode
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
pytest-cache-files-*/
.uv-cache/
.cache/
.venv/
.mypy_cache/
.ruff_cache/
.hypothesis/
htmlcov/
.coverage
coverage.xml


# Local engagements are sensitive. Track only the reusable template scaffolding.
/engagements/*/
!/engagements/_template/
!/engagements/_template/README.md
!/engagements/_template/program/
!/engagements/_template/program/**
!/engagements/_template/manual/
!/engagements/_template/manual/**
!/engagements/_template/agent/
!/engagements/_template/agent/README.md
/engagements/_template/agent/runs/

# Generated runtime state outside an ignored engagement.
/runs/
/artifacts/
/.chainsaw/
**/.chainsaw/
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.jsonl
/benchmarks/scorecard.md
/benchmarks/scorecard.json

# Desktop UI build output and package caches.
/ui/node_modules/
/ui/dist/
/ui/.vite/
/ui/coverage/
/ui/playwright-report/
/ui/test-results/
*.tsbuildinfo
/src-tauri/target/
/ui/src-tauri/target/

# Credentials and machine-local configuration. Examples remain versioned.
.env
.env.*
!.env.example
**/secrets.env
**/secrets.env.*
!**/secrets.env.example
*.pem
*.key
*.p12
*.pfx

# Local tool output and editor state
.tmp/
pytest-temp/
sandbox/test-recon-db/
sandbox/test-local-runner/
.aider*
.DS_Store
Thumbs.db

# Internal research, cloned references, and tests are local-only.
# Only build/run-relevant files belong in the public repository.
/Research/
/tests/

# Machine-local agent/tool configuration and generated state.
/.planning/
/.agents/
/.claude/
/.clinerules
/.codegraph/
/.codegraph.yml
/.mcp.json
/.rtk/
/.tokenade/
/.fastembed_cache/
/AGENTS.md
/CLAUDE.md
/GEMINI.md
*.tokenade-original
